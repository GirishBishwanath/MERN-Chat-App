PORT=4002
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DATABASE=mern_chat_app
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace-with-local-password
POSTGRES_SSL=false
POSTGRES_MAX_CONNECTIONS=10
POSTGRES_IDLE_TIMEOUT_MS=10000
POSTGRES_CONNECTION_TIMEOUT_MS=5000
REDIS_URL=redis://127.0.0.1:6379
JWT_SECRET=replace-with-a-long-random-secret
NODE_ENV=development
CORS_ORIGINS=http://localhost:3001,https://mern-chat-app-jade.vercel.app

KAFKA_ENABLED=true
KAFKA_BROKERS=127.0.0.1:29092
KAFKA_CLIENT_ID=mern-chat-app-api
KAFKA_NOTIFICATION_CONSUMER_GROUP=chat-notification-consumer
