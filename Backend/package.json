{
  "name": "backend",
  "version": "1.0.0",
  "description": "ChatApp ",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "test": "tsx --import ./test/setup-env.js --test auth/*.test.js middleware/*.test.js",
    "test:message": "tsx --test utils/messageCursor.test.ts validation/message.schemas.test.ts repositories/message.repository.test.ts",
    "test:postgres": "npm run test:postgres:migrations && npm run test:postgres:persistence",
    "test:postgres:migrations": "tsx --import ./test/setup-env.js --test test/migrate.persistence.test.ts",
    "test:postgres:persistence": "tsx --import ./test/setup-env.js --test test/postgres.persistence.test.ts",
    "test:socket": "tsx --import ./test/setup-env.js --test SocketIO/server.test.ts",
    "test:redis": "tsx --import ./test/setup-env.js --test infra/redis/redis.test.ts infra/redis/multi-instance.test.ts",
    "db:migrate": "tsx db/migrate.ts",
    "typecheck": "tsc --noEmit",
    "build": "tsc && tsx db/copy-migrations.ts",
    "start": "node dist/index.js",
    "dev": "tsx index.ts",
    "test:security": "tsx --import ./test/setup-env.js --test middleware/securityHardening.test.ts validation/user.schemas.test.ts auth/session.test.js SocketIO/server.test.ts"
  },
  "keywords": [
    "MERN"
  ],
  "author": "Akhilesh",
  "license": "ISC",
  "dependencies": {
    "@socket.io/redis-adapter": "^8.2.0",
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.3.2",
    "nodemon": "^3.1.0",
    "pg": "^8.16.3",
    "redis": "^5.0.2",
    "socket.io": "^4.7.5"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.9",
    "@types/express": "^4.17.21",
    "@types/cors": "^2.8.17",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24.3.1",
    "@types/pg": "^8.15.5",
    "socket.io-client": "^4.7.5",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2"
  }
}
