# Local Docker Compose overrides. These values are development-only.
# Copy to .env if you want to override the safe Compose defaults.

POSTGRES_DATABASE=mern_chat_app
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
JWT_SECRET=replace-with-a-long-local-development-secret
POSTGRES_MAX_CONNECTIONS=10
POSTGRES_IDLE_TIMEOUT_MS=10000
POSTGRES_CONNECTION_TIMEOUT_MS=5000

# Set to true for Windows/WSL bind-mount development if file changes are not detected.
VITE_USE_POLLING=true

KAFKA_PORT_PUBLISHED=29092
